PORT=8000
DATABASE_URL=postgres://user:password@your-host.neon.tech:5432/your_database
JWT_SECRET=super_secret_key_at_least_32_characters
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

RABBIT_URL=amqp://guest:guest@localhost:5672/

# SMTP_USERNAME/SMTP_PASSWORD may be left empty for a local dev SMTP catcher
# (Mailpit, MailHog) that accepts mail without AUTH. A real relay (SES,
# SendGrid, ...) requires both.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
